ENVIRONMENT=demo
# Local default. For deployed durability, use a PostgreSQL URL from your managed DB.
DATABASE_URL=sqlite:///./paypilot.db
LANGGRAPH_DB_PATH=./langgraph.db
LANGGRAPH_STRICT_MSGPACK=true

# Optional. Leave blank for deterministic demo parsing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Use the exact frontend origin in deployment, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173
DEMO_SESSION_TTL_HOURS=24
AGENT_RUNS_PER_MINUTE=12
GLOBAL_AGENT_RUNS_PER_MINUTE=120
SESSION_CREATES_PER_MINUTE=60
MAX_TRANSFER_AMOUNT=100000
AUTO_EXECUTE_THRESHOLD=2000
HIGH_RISK_BLOCK_SCORE=95
